// Eligible.ai Database Markup Language (DBML)
// Copy-paste this file directly into https://dbdiagram.io

Table states {
  code varchar [pk]
  name varchar
  iso_code varchar
  lgd_code int
  is_active boolean
}

Table districts {
  id int [pk, increment]
  state_code varchar [ref: > states.code]
  name varchar
  lgd_code int
  is_active boolean
}

Table ministries {
  id uuid [pk]
  name varchar
  short_name varchar
  level varchar
  state_code varchar [ref: > states.code]
  website_url text
}

Table departments {
  id uuid [pk]
  ministry_id uuid [ref: > ministries.id]
  name varchar
  website_url text
}

Table categories {
  id uuid [pk]
  slug varchar [unique]
  name varchar
  description text
  parent_id uuid [ref: > categories.id]
  display_order int
}

Table document_types {
  id uuid [pk]
  code varchar [unique]
  name varchar
  issuing_authority varchar
  is_identity_proof boolean
  is_income_proof boolean
  is_address_proof boolean
}

Table users {
  id uuid [pk]
  email varchar [unique]
  phone_number varchar [unique]
  password_hash varchar
  full_name varchar
  role varchar
  preferred_language varchar
  created_at timestamptz
}

Table user_profiles {
  id uuid [pk]
  user_id uuid [ref: > users.id]
  relationship varchar
  full_name varchar
  date_of_birth date
  gender varchar
  caste_category varchar
  annual_household_income numeric
  is_bpl boolean
  state_code varchar [ref: > states.code]
  district_id int [ref: > districts.id]
  occupation_type varchar
  education_level varchar
  is_differently_abled boolean
  land_holding_acres numeric
}

Table user_documents {
  id uuid [pk]
  user_id uuid [ref: > users.id]
  profile_id uuid [ref: > user_profiles.id]
  document_type_id uuid [ref: > document_types.id]
  document_number_masked varchar
  document_number_hash varchar
  file_storage_path text
  is_verified boolean
}

Table schemes {
  id uuid [pk]
  slug varchar [unique]
  code varchar [unique]
  title varchar
  short_description text
  scheme_level varchar
  state_code varchar [ref: > states.code]
  ministry_id uuid [ref: > ministries.id]
  department_id uuid [ref: > departments.id]
  category_id uuid [ref: > categories.id]
  benefit_type varchar
  benefit_summary text
  max_benefit_amount numeric
  official_portal_url text
  application_portal_url text
  status varchar
  is_perpetual boolean
  application_deadline date
  current_version int
}

Table scheme_eligibility_criteria {
  id uuid [pk]
  scheme_id uuid [ref: - schemes.id]
  min_age int
  max_age int
  allowed_genders "varchar[]"
  allowed_castes "varchar[]"
  max_annual_income numeric
  allowed_states "varchar[]"
  allowed_occupations "varchar[]"
  requires_bpl boolean
  requires_differently_abled boolean
  complex_rules_json jsonb
  criteria_summary text
}

Table scheme_documents {
  id uuid [pk]
  scheme_id uuid [ref: > schemes.id]
  document_type_id uuid [ref: > document_types.id]
  is_mandatory boolean
  purpose text
}

Table scheme_translations {
  id uuid [pk]
  scheme_id uuid [ref: > schemes.id]
  language_code varchar
  title varchar
  short_description text
  benefit_summary text
}

Table sources {
  id uuid [pk]
  name varchar
  base_url text
  level varchar
  state_code varchar [ref: > states.code]
  scraper_module_name varchar
  crawl_frequency_hours int
}

Table crawl_logs {
  id uuid [pk]
  source_id uuid [ref: > sources.id]
  started_at timestamptz
  finished_at timestamptz
  schemes_discovered int
  status varchar
}

Table raw_scheme_snapshots {
  id uuid [pk]
  source_id uuid [ref: > sources.id]
  crawl_log_id uuid [ref: > crawl_logs.id]
  source_url text
  raw_content text
  content_hash varchar
  parsed_scheme_id uuid [ref: > schemes.id]
  is_processed boolean
}

Table scheme_versions {
  id uuid [pk]
  scheme_id uuid [ref: > schemes.id]
  version_number int
  scheme_snapshot_json jsonb
  change_summary text
  created_at timestamptz
}

Table scheme_change_logs {
  id uuid [pk]
  scheme_id uuid [ref: > schemes.id]
  field_name varchar
  old_value text
  new_value text
  detected_at timestamptz
}

Table scheme_embeddings {
  id uuid [pk]
  scheme_id uuid [ref: > schemes.id]
  model_name varchar
  embedding text
}

Table user_scheme_matches {
  id uuid [pk]
  user_id uuid [ref: > users.id]
  profile_id uuid [ref: > user_profiles.id]
  scheme_id uuid [ref: > schemes.id]
  match_score numeric
  is_fully_eligible boolean
  matched_criteria jsonb
  unmatched_criteria jsonb
}

Table user_applications {
  id uuid [pk]
  user_id uuid [ref: > users.id]
  profile_id uuid [ref: > user_profiles.id]
  scheme_id uuid [ref: > schemes.id]
  status varchar
  application_reference_number varchar
  official_application_date date
  disbursed_amount numeric
}

Table application_status_history {
  id uuid [pk]
  application_id uuid [ref: > user_applications.id]
  previous_status varchar
  new_status varchar
  remarks text
  created_at timestamptz
}

Table notifications {
  id uuid [pk]
  user_id uuid [ref: > users.id]
  scheme_id uuid [ref: > schemes.id]
  channel varchar
  notification_type varchar
  title varchar
  body text
  is_read boolean
  scheduled_for timestamptz
}

Table user_notification_preferences {
  user_id uuid [pk, ref: - users.id]
  email_enabled boolean
  whatsapp_enabled boolean
  sms_enabled boolean
  in_app_enabled boolean
  deadline_remind_days_before "int[]"
}
