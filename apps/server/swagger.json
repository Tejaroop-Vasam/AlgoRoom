        },
        "summary": "Join a room by code",
        "tags": [
          "Rooms"
        ]
      }
    }
  },
  "info": {
    "title": "AlgoRoom API",
    "description": "REST API documentation for the AlgoRoom collaborative DSA platform",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "JWT-auth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "name": "Authorization",
        "description": "Enter your JWT token",
        "in": "header"
      }
    },
    "schemas": {
      "RegisterUserDto": {
        "type": "object",
        "properties": {}
      },
      "LoginUserDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {}
      },
      "UserProfileDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "usr_123"
          },
          "username": {
            "type": "string",
            "example": "johndoe"
          },
          "email": {
            "type": "string",
            "example": "john@example.com"
          },
          "is_admin": {
            "type": "boolean",
            "example": false
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "email",
          "is_admin",
          "created_at"
        ]
      },
      "ProfileResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserProfileDto"
          }
        },
        "required": [
          "user"
        ]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {}
      },
      "GoogleOAuthDto": {
        "type": "object",
        "properties": {}
      },
      "ProblemListItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1,
            "description": "Unique problem identifier"
          },
          "title": {
            "type": "string",
            "example": "Two Sum",
            "description": "Problem title"
          },
          "difficulty": {
            "type": "string",
            "example": "EASY",
            "enum": [
              "EASY",
              "MEDIUM",
              "HARD"
            ],
            "description": "Difficulty level"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "description": "Created timestamp"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string",
            "description": "Updated timestamp"
          }
        },
        "required": [
          "id",
          "title",
          "difficulty",
          "createdAt",
          "updatedAt"
        ]
      },
      "ProblemsListResponseDto": {
        "type": "object",
        "properties": {
          "problems": {
            "description": "List of problems matching the query",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProblemListItemDto"
            }
          },
          "total": {
            "type": "number",
            "example": 75,
            "description": "Total number of problems matching the query"
          },
          "page": {
            "type": "number",
            "example": 1,
            "description": "Current page number"
          },
          "limit": {
            "type": "number",
            "example": 20,
            "description": "Items per page limit"
          },
          "totalPages": {
            "type": "number",
            "example": 4,
            "description": "Total number of pages"
          }
        },
        "required": [
          "problems",
          "total",
          "page",
          "limit",
          "totalPages"
        ]
      },
      "SampleTestCaseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "input": {
            "type": "string"
          },
          "expectedOutput": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          }
        },
        "required": [
          "input",
          "expectedOutput"
        ]
      },
      "ProblemDetailResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "title": {
            "type": "string",
            "example": "Two Sum"
          },
          "description": {
            "type": "string",
            "example": "Given an array of integers nums and an integer target..."
          },
          "difficulty": {
            "type": "string",
            "example": "EASY",
            "enum": [
              "EASY",
              "MEDIUM",
              "HARD"
            ]
          },
          "constraints": {
            "example": [
              "2 <= nums.length <= 104"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hints": {
            "example": [
              "A really brute force way would be to search for all possible pairs..."
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sampleTestCases": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SampleTestCaseDto"
            }
          },
          "starterTemplates": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "starterCodes": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "timeLimitMs": {
            "type": "number",
            "example": 2000
          },
          "memoryLimitMb": {
            "type": "number",
            "example": 256
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "difficulty",
          "constraints",
          "hints",
          "sampleTestCases",
          "starterTemplates",
          "starterCodes",
          "timeLimitMs",
          "memoryLimitMb",
          "createdAt",
          "updatedAt"
        ]
      },
      "RunCodeDto": {
        "type": "object",
        "properties": {}
      },
      "ExecutionResultDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "SUCCESS",
              "TIME_LIMIT_EXCEEDED",
              "MEMORY_LIMIT_EXCEEDED",
              "COMPILE_ERROR",
              "RUNTIME_ERROR"
            ],
            "example": "SUCCESS"
          },
          "stdout": {
            "type": "string",
            "example": "true"
          },
          "stderr": {
            "type": "string",
            "example": ""
          },
          "executionTimeMs": {
            "type": "number",
            "example": 45
          }
        },
        "required": [
          "status",
          "stdout",
          "stderr",
          "executionTimeMs"
        ]
      },
      "SubmitCodeDto": {
        "type": "object",
        "properties": {}
      },
      "TestCaseEvaluationResultDto": {
        "type": "object",
        "properties": {
          "testCaseIndex": {
            "type": "number",
            "example": 1
          },
          "verdict": {
            "type": "string",
            "enum": [
              "ACCEPTED",
              "WRONG_ANSWER",
              "TIME_LIMIT_EXCEEDED",
              "MEMORY_LIMIT_EXCEEDED",
              "COMPILE_ERROR",
              "RUNTIME_ERROR"
            ],
            "example": "ACCEPTED"
          },
          "input": {
            "type": "string",
            "example": "s = \"()\""
          },
          "expectedOutput": {
            "type": "string",
            "example": "true"
          },
          "actualOutput": {
            "type": "string",
            "example": "true"
          },
          "stderr": {
            "type": "string",
            "example": ""
          },
          "executionTimeMs": {
            "type": "number",
            "example": 45
          }
        },
        "required": [
          "testCaseIndex",
          "verdict",
          "input",
          "expectedOutput",
          "actualOutput",
          "stderr",
          "executionTimeMs"
        ]
      },
      "SubmissionEvaluationResultDto": {
        "type": "object",
        "properties": {
          "passed": {
            "type": "boolean",
            "example": true
          },
          "totalCount": {
            "type": "number",
            "example": 5
          },
          "passedCount": {
            "type": "number",
            "example": 5
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TestCaseEvaluationResultDto"
            }
          }
        },
        "required": [
          "passed",
          "totalCount",
          "passedCount",
          "results"
        ]
      },
      "FormatLanguage": {
        "type": "string",
        "enum": [
          "python",
          "cpp",
          "java",
          "javascript",
          "typescript"
        ],
        "description": "Programming language to format"
      },
      "FormatCodeDto": {
        "type": "object",
        "properties": {
          "language": {
            "description": "Programming language to format",
            "example": "python",
            "allOf": [
              {
                "$ref": "#/components/schemas/FormatLanguage"
              }
            ]
          },
          "code": {
            "type": "string",
            "description": "Source code to format"
          }
        },
        "required": [
          "language",
          "code"
        ]
      },
      "FormatResultDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Formatted code or original code if formatting failed"
          },
          "formatted": {
            "type": "boolean",
            "description": "Whether the code was successfully formatted",
            "example": true
          },
          "error": {
            "type": "string",
            "description": "Error message if formatting failed"
          }
        },
        "required": [
          "code",
          "formatted"
        ]
      },
      "CreateRoomDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Room name"
          },
          "mode": {
            "type": "string",
            "enum": [
              "RACE",
              "COOP"
            ],
            "description": "Room mode"
          },
          "problemIds": {
            "description": "List of problem IDs",
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "maxParticipants": {
            "type": "number",
            "description": "Max participants",
            "default": 4
          },
          "hiddenTestCases": {
            "type": "boolean",
            "description": "Hidden test cases",
            "default": true
          },
          "bufferVisibility": {
            "type": "string",
            "enum": [
              "OBSCURED",
              "HOST_ONLY",
              "OPEN"
            ],
            "description": "Buffer visibility"
          }
        },
        "required": [
          "name",
          "mode",
          "problemIds",
          "maxParticipants",
          "hiddenTestCases",
          "bufferVisibility"
        ]
      },
      "RoomParticipantDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "host-user-1"
          },
          "username": {
            "type": "string",
            "example": "Host"
          },
          "isHost": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "id",
          "username",
          "isHost"
        ]
      },
      "RoomSettingsDto": {
        "type": "object",
        "properties": {
          "maxParticipants": {
            "type": "number",
            "example": 4
          },
          "hiddenTestCases": {
            "type": "boolean",
            "example": true
          },
          "bufferVisibility": {
            "type": "string",
            "example": "OBSCURED",
            "enum": [
              "OBSCURED",
              "HOST_ONLY",
              "OPEN"
            ]
          }
        },
        "required": [
          "maxParticipants",
          "hiddenTestCases",
          "bufferVisibility"
        ]
      },
      "RoomDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "room-1729060000000"
          },
          "code": {
            "type": "string",
            "example": "ABCDEF"
          },
          "name": {
            "type": "string",
            "example": "My Room"
          },
          "mode": {
            "type": "string",
            "example": "RACE",
            "enum": [
              "RACE",
              "COOP"
            ]
          },
          "status": {
            "type": "string",
            "example": "LOBBY",
            "enum": [
              "LOBBY",
              "IN_PROGRESS",
              "FINISHED"
            ]
          },
          "host": {
            "$ref": "#/components/schemas/RoomParticipantDto"
          },
          "participants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoomParticipantDto"
            }
          },
          "problemIds": {
            "example": [
              1,
              2
            ],
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "settings": {
            "$ref": "#/components/schemas/RoomSettingsDto"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "code",
          "name",
          "mode",
          "status",
          "host",
          "participants",
          "problemIds",
          "settings",
          "createdAt"
        ]
      },
      "RoomPreviewDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "ABCDEF"
          },
          "name": {
            "type": "string",
            "example": "My Room"
          },
          "mode": {
            "type": "string",
            "example": "RACE",
            "enum": [
              "RACE",
              "COOP"
            ]
          },
          "status": {
            "type": "string",
            "example": "LOBBY",
            "enum": [
              "LOBBY",
              "IN_PROGRESS",
              "FINISHED"
            ]
