              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailResponseDto"
                }
              }
            }
          }
        },
        "summary": "Get DSA problem statement, constraints, and starter codes by ID",
        "tags": [
          "Problems"
        ]
      }
    },
    "/api/run": {
      "post": {
        "operationId": "RunnerController_run",
        "parameters": [],
