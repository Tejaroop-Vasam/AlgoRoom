    "/problems": {
      "get": {
        "operationId": "ProblemsController_getProblems",
        "parameters": [
          {
            "name": "difficulty",
            "required": false,
            "in": "query",
            "description": "Difficulty level",
            "schema": {
              "type": "string",
              "enum": [
                "EASY",
                "MEDIUM",
                "HARD"
              ]
            }
          },
          {
            "name": "search",
            "required": false,
            "in": "query",
            "description": "Search term by problem title or description",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Page number",
            "schema": {
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Page limit",
            "schema": {
              "default": 20,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of problems",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemsListResponseDto"
                }
              }
            }
          }
        },
        "summary": "List and filter DSA problems with pagination",
        "tags": [
          "Problems"
        ]
      }
    },
    "/problems/{id}": {
      "get": {
        "operationId": "ProblemsController_getProblem",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Problem statement details",
