        "description": "Enter your JWT token",
        "in": "header"
      }
    },
    "schemas": {
      "RegisterUserDto": {
        "type": "object",
        "properties": {}
      },
      "LoginUserDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {}
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {}
      },
      "GoogleOAuthDto": {
        "type": "object",
        "properties": {}
      },
      "RunCodeDto": {
        "type": "object",
        "properties": {}
      },
      "SubmitCodeDto": {
        "type": "object",
        "properties": {}
      },
      "CreateRoomDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Room name"
          },
          "mode": {
            "type": "string",
            "enum": [
              "RACE",
              "COOP"
            ],
            "description": "Room mode"
          },
          "problemIds": {
            "description": "List of problem IDs",
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "maxParticipants": {
            "type": "number",
            "description": "Max participants",
            "default": 4
          },
          "hiddenTestCases": {
            "type": "boolean",
            "description": "Hidden test cases",
            "default": true
          },
          "bufferVisibility": {
            "type": "string",
            "enum": [
              "OBSCURED",
              "HOST_ONLY",
              "OPEN"
            ],
            "description": "Buffer visibility"
          }
        },
        "required": [
          "name",
          "mode",
          "problemIds",
          "maxParticipants",
          "hiddenTestCases",
          "bufferVisibility"
        ]
      }
    }
