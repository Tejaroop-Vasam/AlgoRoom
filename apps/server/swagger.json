        ]
      }
    },
    "/rooms/{code}": {
      "get": {
        "operationId": "RoomsController_getRoomPreview",
        "parameters": [
          {
            "name": "code",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Room preview details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoomPreviewDto"
                }
              }
            }
          }
        },
        "summary": "Get preview for a room by code",
