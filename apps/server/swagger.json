    "/problems": {
      "get": {
        "operationId": "ProblemsController_getProblems",
        "parameters": [
          {
            "name": "difficulty",
            "required": false,
            "in": "query",
            "description": "Difficulty level",
            "schema": {
              "type": "string",
              "enum": [
                "EASY",
                "MEDIUM",
                "HARD"
              ]
            }
          },
          {
            "name": "search",
            "required": false,
