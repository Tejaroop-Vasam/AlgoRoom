              }
            }
          }
        },
        "summary": "Execute code against custom input or problem sample test case",
        "tags": [
          "Code Runner"
        ]
      }
    },
    "/api/submit": {
      "post": {
        "operationId": "RunnerController_submit",
        "parameters": [],
