        "title": "AuthResultDto"
      },
      "BufferVisibility": {
        "type": "string",
        "enum": [
          "OBSCURED",
          "HOST_ONLY",
          "OPEN"
        ],
        "title": "BufferVisibility"
      },
      "ChangePasswordDto": {
        "properties": {
          "oldPassword": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Oldpassword"
          },
          "newPassword": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 8,
            "title": "Newpassword"
          }
        },
        "type": "object",
        "required": [
          "oldPassword",
          "newPassword"
        ],
        "title": "ChangePasswordDto"
      },
      "CreateRoomDto": {
        "properties": {
          "maxParticipants": {
            "type": "integer",
            "maximum": 8.0,
            "minimum": 2.0,
            "title": "Maxparticipants",
            "default": 4
          },
          "hiddenTestCases": {
            "type": "boolean",
            "title": "Hiddentestcases",
            "default": true
          },
          "bufferVisibility": {
            "$ref": "#/components/schemas/BufferVisibility",
            "default": "OBSCURED"
          },
          "name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Name"
          },
          "mode": {
            "$ref": "#/components/schemas/RoomMode"
          },
          "problemIds": {
            "items": {
              "type": "integer",
              "maximum": 2147483647.0,
              "exclusiveMinimum": 0.0
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 1,
            "title": "Problemids"
          }
        },
        "type": "object",
        "required": [
          "name",
          "mode",
          "problemIds"
        ],
        "title": "CreateRoomDto"
      },
      "CreatedRoomDto": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "mode": {
            "$ref": "#/components/schemas/RoomMode"
          },
          "status": {
            "$ref": "#/components/schemas/RoomStatus"
          },
          "host": {
            "$ref": "#/components/schemas/RoomParticipantDto"
          },
          "participants": {
            "items": {
              "$ref": "#/components/schemas/RoomParticipantDto"
            },
            "type": "array",
            "title": "Participants"
          },
          "problemIds": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Problemids"
          },
          "settings": {
            "$ref": "#/components/schemas/RoomSettingsDto"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "title": "Createdat"
          },
          "hostSession": {
            "allOf": [
              {
                "$ref": "#/components/schemas/GuestHostSessionDto"
              }
            ],
            "nullable": true
          }
        },
        "type": "object",
        "required": [
          "id",
          "code",
          "name",
          "mode",
          "status",
          "host",
          "participants",
          "problemIds",
          "settings",
          "createdAt"
        ],
        "title": "CreatedRoomDto"
      },
      "Difficulty": {
        "type": "string",
        "enum": [
          "EASY",
          "MEDIUM",
          "HARD"
        ],
        "title": "Difficulty"
      },
      "ExecutionResultDto": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ExecutionStatus"
          },
          "stdout": {
            "type": "string",
            "title": "Stdout"
          },
          "stderr": {
            "type": "string",
            "title": "Stderr"
          },
          "executionTimeMs": {
            "type": "integer",
            "title": "Executiontimems"
          }
        },
        "type": "object",
        "required": [
          "status",
          "stdout",
          "stderr",
          "executionTimeMs"
        ],
        "title": "ExecutionResultDto"
      },
      "ExecutionStatus": {
        "type": "string",
        "enum": [
          "SUCCESS",
          "TIME_LIMIT_EXCEEDED",
          "MEMORY_LIMIT_EXCEEDED",
          "COMPILE_ERROR",
          "RUNTIME_ERROR"
        ],
        "title": "ExecutionStatus"
      },
      "FormatCodeDto": {
        "properties": {
          "language": {
            "$ref": "#/components/schemas/FormatLanguage"
          },
          "code": {
            "type": "string",
            "maxLength": 65536,
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "language",
          "code"
        ],
        "title": "FormatCodeDto"
      },
      "FormatLanguage": {
        "type": "string",
        "enum": [
          "python",
          "cpp",
          "java",
          "javascript",
          "typescript"
        ],
        "title": "FormatLanguage"
      },
      "FormatResultDto": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "formatted": {
            "type": "boolean",
            "title": "Formatted"
          },
          "error": {
            "title": "Error",
            "type": "string",
            "nullable": true
          }
        },
        "type": "object",
        "required": [
          "code",
          "formatted"
        ],
        "title": "FormatResultDto"
      },
      "GoogleOAuthDto": {
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 8192,
            "minLength": 1,
            "title": "Token"
          }
        },
        "type": "object",
        "required": [
          "token"
        ],
        "title": "GoogleOAuthDto"
      },
      "GuestHostSessionDto": {
        "properties": {
          "token": {
            "type": "string",
            "title": "Token"
          },
          "expiresAt": {
            "type": "integer",
            "title": "Expiresat"
          }
        },
        "type": "object",
        "required": [
          "token",
          "expiresAt"
        ],
        "title": "GuestHostSessionDto"
      },
      "Language": {
        "type": "string",
        "enum": [
          "python",
          "cpp",
          "java"
        ],
        "title": "Language"
      },
      "LoginUserDto": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 300,
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginUserDto"
      },
      "MessageDto": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "MessageDto"
      },
      "ProblemDetailResponseDto": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "difficulty": {
            "$ref": "#/components/schemas/Difficulty"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "title": "Createdat"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Updatedat"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "constraints": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Constraints"
          },
          "hints": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Hints"
          },
          "sampleTestCases": {
            "items": {
              "$ref": "#/components/schemas/SampleTestCaseDto"
