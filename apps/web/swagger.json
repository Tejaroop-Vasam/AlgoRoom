            "type": "array",
            "title": "Sampletestcases"
          },
          "starterTemplates": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Startertemplates"
          },
          "starterCodes": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Startercodes"
          },
          "timeLimitMs": {
            "type": "integer",
            "title": "Timelimitms"
          },
          "memoryLimitMb": {
            "type": "integer",
            "title": "Memorylimitmb"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "difficulty",
          "createdAt",
          "updatedAt",
          "description",
          "constraints",
          "hints",
          "sampleTestCases",
          "starterTemplates",
          "starterCodes",
          "timeLimitMs",
          "memoryLimitMb"
