    "/problems": {
      "get": {
        "tags": [
          "Problems"
        ],
        "summary": "Problems",
        "operationId": "ProblemsController_getProblems",
        "parameters": [
          {
            "name": "difficulty",
            "in": "query",
            "required": false,
            "schema": {
              "description": "Filter by difficulty",
              "title": "Difficulty",
              "allOf": [
                {
                  "$ref": "#/components/schemas/Difficulty"
                }
              ],
              "nullable": true
            },
            "description": "Filter by difficulty"
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "description": "Search problem titles and descriptions",
              "title": "Search",
              "type": "string",
              "maxLength": 500,
              "nullable": true
            },
            "description": "Search problem titles and descriptions"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 2147483647,
              "minimum": 1,
              "description": "Page number",
              "default": 1,
              "title": "Page"
            },
            "description": "Page number"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Results per page",
              "default": 20,
              "title": "Limit"
            },
            "description": "Results per page"
